

// OST2 (2026-06-13): re-position popovers after late layout shifts. The Progress
// page grade bar uses Paragon popovers (Popper.js) for the current-grade / passing-
// grade markers; they position on mount, but the staff "View this course as" toolbar
// renders AFTER and pushes the bar down ~90px without re-positioning them, leaving
// the markers floating off the line (staff-only -- learners never see that toolbar).
// A synthetic window 'resize' makes Popper re-run positioning. NOTE: a ResizeObserver
// on <html> does NOT work here -- the MFE renders in a fixed-height app shell, so
// documentElement's box stays constant (clientHeight pinned ~873, only scrollHeight
// grows); the observer fires once at startup (before the markers mount) and never on
// the toolbar shift. Instead fire a short burst of timed resizes after each full load
// AND after each SPA route change (history pushState/replaceState/popstate), so at
// least one always lands after the toolbar settles. No-op on pages without popovers.
(function () {
  if (typeof window === 'undefined' || window.__ost2RepositionNudge) { return; }
  window.__ost2RepositionNudge = true;
  var DELAYS = [400, 1000, 1800, 3000, 5000];
  var pending = [];
  var fireResize = function () {
    try { window.dispatchEvent(new Event('resize')); } catch (e) { /* noop */ }
  };
  var burst = function () {
    pending.forEach(clearTimeout); pending = [];
    for (var i = 0; i < DELAYS.length; i++) { pending.push(setTimeout(fireResize, DELAYS[i])); }
  };
  burst(); // initial full-page load
  try {
    var wrap = function (orig) {
      return function () { var r = orig.apply(this, arguments); burst(); return r; };
    };
    history.pushState = wrap(history.pushState);
    history.replaceState = wrap(history.replaceState);
    window.addEventListener('popstate', burst);
  } catch (e) { /* history patch failed; the initial burst still ran */ }
})();

// Links-only replacement for @edly-io/indigo-frontend-component-footer: same
// wrapper/nav markup and classes (so the brand package's light/dark footer CSS
// still applies), but without the "Powered by" Tutor/Open edX logos and the
// "Copyrights (c)YEAR. All Rights Reserved." line. Link URLs are used verbatim
// because OST2's footer links are absolute (https://ost2.fyi/...).
const OST2Footer = () => {
  const footerNavLinks = getConfig().INDIGO_FOOTER_NAV_LINKS || [];
  const ost2MfeCss = { __html: `.wrapper-footer .nav-colophon a{color:#1a1a1a !important;}body.indigo-dark-theme .wrapper-footer .nav-colophon a{color:#f8f8f8 !important;}.wrapper-footer .nav-colophon a:hover,.wrapper-footer .nav-colophon a:focus{text-decoration:underline;}body.indigo-dark-theme .pgn__stateful-btn.btn-primary{color:#0d0d0e !important;}body.indigo-dark-theme .pgn__searchfield__button.btn-primary{color:#0d0d0e !important;}body.indigo-dark-theme select{color-scheme:dark;}body.indigo-dark-theme select option,body.indigo-dark-theme select optgroup{background-color:#292a2c;color:#f8f8f8;}body.indigo-dark-theme .tox .tox-toolbar-overlord,body.indigo-dark-theme .tox .tox-toolbar,body.indigo-dark-theme .tox .tox-toolbar__primary,body.indigo-dark-theme .tox .tox-toolbar__overflow{background-color:#292a2c !important;}body.indigo-dark-theme .tox .tox-tbtn svg{fill:#f8f8f8 !important;}body.indigo-dark-theme .tox .tox-tbtn--disabled svg,body.indigo-dark-theme .tox .tox-tbtn:disabled svg{fill:rgba(248,248,248,.4) !important;}body.indigo-dark-theme .tox .tox-tbtn:hover{background-color:#36383b !important;}body.indigo-dark-theme .tox .tox-tbtn__select-label,body.indigo-dark-theme .tox .tox-statusbar,body.indigo-dark-theme .tox .tox-statusbar a,body.indigo-dark-theme .tox .tox-statusbar__path-item{color:#dddfe2 !important;}body.indigo-dark-theme .pgn__form-switch-helper-text{color:#b0b0b0 !important;}body.indigo-dark-theme #root .alert.alert-success a.inline-link{background:none;color:#aec7f6;padding:0;}` };

  // Style objects are consts, not inline props, because a double open-brace is a Jinja print.
  const telescopeWrapStyle = { textAlign: 'center', margin: '12px 0 0' };
  const telescopeImgStyle = { height: '165px', width: 'auto' };

  return (
    <div className="wrapper wrapper-footer">
      {/* OST2: this <style> renders on EVERY MFE (the footer is global), so it carries a
          few app-wide dark-mode contrast fixes that the brand theme missed:
          - footer nav links: bare <a> stuck at brand slate #374151 (~1.9:1 on dark) ->
            near-black in light, near-white in dark.
          - .pgn__stateful-btn.btn-primary (e.g. the staff "View as" Submit on the learner
            dashboard): white text stayed on the light-accent (#aec7f6) dark-mode button bg
            (1.7:1) -> near-black, matching how the brand already darkens btn-primary text in
            dark. Only the filled variant: link-style stateful buttons ("Bookmark this page",
            account "Reset Password") sit on the dark page and must keep light text. The
            course-search Search button is the same case.
          - select option lists: light text inherited onto the browser's white option list.
          - TinyMCE (discussion post editor): navy toolbar icons on the dark toolbar, and a
            white strip behind it.
          - .pgn__form-switch-helper-text: #707070 helper stuck in both themes (3.9:1 on
            dark) -> lighter grey in dark.
          - a.inline-link inside a success alert (Li'l Stranger mascot links, Timing Feedback
            numbers): the brand's dark `.alert.alert-success a` rule fills every alert link as a
            light-blue button; its inline-link exemption does not cover this selector. */}
      <style dangerouslySetInnerHTML={ost2MfeCss} />
      <footer id="footer" className="tutor-container">
        <div className="footer-top">
          {footerNavLinks.length > 0 && (
            <nav className="nav-colophon" aria-label="About">
              <ol>
                {footerNavLinks.map((link) => (
                  <li key={link.url}>
                    <a href={link.url}>{link.title}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )}
          {/* Li'l Stranger peering up at the links; links to the LMS hello page. */}
          <div className="lil-stranger-telescope" style={telescopeWrapStyle}>
            <a href={`${getConfig().LMS_BASE_URL}/lil-stranger/`}>
              <img
                src={`${getConfig().LMS_BASE_URL}/lil-stranger/telescope.webp`}
                alt="Looking for how to help..."
                style={telescopeImgStyle}
              />
            </a>
          </div>
        </div>
      </footer>
    </div>
  );
};

let themeCookie = 'indigo-toggle-dark';
let themeCookieExpiry = 90; // days

const AddDarkTheme = () => {
  const cookies = new Cookies();
  const isThemeToggleEnabled = getConfig().INDIGO_ENABLE_DARK_TOGGLE;

  const getCookieExpiry = () => {
    const today = new Date();
    return new Date(today.getFullYear(), today.getMonth(), today.getDate() + themeCookieExpiry);
  };

  const getCookieOptions = () => {
    const serverURL = new URL(getConfig().LMS_BASE_URL);
    const options = { domain: serverURL.hostname, path: '/', expires: getCookieExpiry() };
    return options;
  };

  // Shared id so P1 (this on-load injector), P2 (the header ThemeToggleButton)
  // and P3 (the LmsHtmlFragment srcDoc script) all own AT MOST ONE dark style
  // per iframe. Keeping the id identical lets injection be idempotent (skip if
  // present) and removal complete (remove every node with this id).
  const iframeDarkStyleId = 'ost2-iframe-dark';
  const iframeDarkCss = `
          body{
            background-color: #0D0D0E;
            color: #F8F8F8;
          }
          h1,h2,h3,h4,h5,h6,p,li,span,div,td,th,dt,dd,label,blockquote,figcaption {color: #F8F8F8 !important;}
          a, a * {color: #AEC7F6 !important;}
          a:hover{color: #d3d3d3;}
          .forum-nav-refine-bar,.forum-nav-sort-control,.forum-nav-thread-list,.forum-nav,.forum-nav-load-more {background-color: #0D0D0E !important;}
          .forum-nav-refine-bar,.forum-nav-refine-bar *,.forum-nav-sort-control,.forum-nav-sort-control select,.forum-nav-load-more a {color: #F8F8F8 !important;}
          `;

  const addDarkThemeToIframes = () => {
    const iframes = document.getElementsByTagName('iframe');
    const iframesLength = iframes.length;
    if (iframesLength > 0) {
      Array.from({ length: iframesLength }).forEach((_, index) => {
        const iframeDoc = iframes[index].contentDocument;
        if (!iframeDoc || !iframeDoc.head) { return; }
        // Idempotent: at most one dark style per iframe head. The 15s
        // MutationObserver fires on every DOM mutation, so a non-idempotent
        // append would stack many duplicate styles in a single iframe.
        if (iframeDoc.getElementById(iframeDarkStyleId)) { return; }
        const style = iframeDoc.createElement('style');
        style.id = iframeDarkStyleId;
        style.textContent = iframeDarkCss;
        iframeDoc.head.appendChild(style);
      });
    }
  };

  const removeDarkThemeFromIframes = () => {
    const iframes = document.getElementsByTagName('iframe');
    const iframesLength = iframes.length;
    Array.from({ length: iframesLength }).forEach((_, index) => {
      const iframeDoc = iframes[index].contentDocument;
      if (!iframeDoc || !iframeDoc.head) { return; }
      // Remove ALL dark styles in this iframe head (not a single .find()), so
      // any leftover/duplicate style is cleared on toggle->light.
      iframeDoc.head.querySelectorAll(`style#${iframeDarkStyleId}`).forEach((node) => node.remove());
    });
  };

  useEffect(() => {
    const theme = cookies.get(themeCookie);

    // - When page loads, Footer loads before MFE content. Since there is no iframe on page,
    // it does not append any class. MutationObserver observes changes in DOM and hence appends dark
    // attributes when iframe is added. After 15 sec, this observer is destroyed to conserve resources. 
    // - It has been added outside dark-theme condition so that it can be removed on Component Unmount.
    // - Observer can be passed to `addDarkThemeToIframes` function and disconnected after observing Iframe.
    // This approach has a limitation: the observer first detects the iframe and then detects the docSrc. 
    // We need to wait for docSrc to fully load before appending the style tag.
    const observer = new MutationObserver(() => {
      // Decide from the ACTUAL visible state, not the (possibly stale) cookie:
      // if the user toggled to light during this 15s window, P2 already removed
      // the iframe styles - re-adding here would re-darken them. Only inject
      // while the body is still dark; otherwise clear any leftovers.
      if (document.body.classList.contains('indigo-dark-theme')) {
        addDarkThemeToIframes();
      } else {
        removeDarkThemeFromIframes();
      }
    });

    if (isThemeToggleEnabled && theme === 'dark') {
      document.body.classList.add('indigo-dark-theme');
      
      observer.observe(document.body, { childList: true, subtree: true });
      setTimeout(() => observer?.disconnect(), 15000); // clear after 15 sec to avoid resource usage

      cookies.set(themeCookie, theme, getCookieOptions());      //  on page load, update expiry
    }

    return () => observer?.disconnect();
  }, []);

  // OST2: swap the header logo for the white-on-black variant in dark mode.
  // LOGO_URL comes from MFE_CONFIG (/theming/asset/images/logo.png on the LMS).
  const darkLogoCss = { __html: 'body.indigo-dark-theme img[src$="/images/logo.png"]{content:url(' + getConfig().LMS_BASE_URL + '/theming/asset/images/logo-dark.png);}' };

  return (<div><style dangerouslySetInnerHTML={darkLogoCss} /></div>);
};
