

// Links-only replacement for @edly-io/indigo-frontend-component-footer: same
// wrapper/nav markup and classes (so the brand package's light/dark footer CSS
// still applies), but without the "Powered by" Tutor/Open edX logos and the
// "Copyrights (c)YEAR. All Rights Reserved." line. Link URLs are used verbatim
// because OST2's footer links are absolute (https://ost2.fyi/...).
const OST2Footer = () => {
  const footerNavLinks = getConfig().INDIGO_FOOTER_NAV_LINKS || [];

  return (
    <div className="wrapper wrapper-footer">
      <footer id="footer" className="tutor-container">
        <div className="footer-top">
          {footerNavLinks.length > 0 && (
            <nav className="nav-colophon" aria-label="About">
              <ol>
                {footerNavLinks.map((link) => (
                  <li key={link.url}>
                    <a href={link.url}>{link.title}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )}
        </div>
      </footer>
    </div>
  );
};

let themeCookie = 'indigo-toggle-dark';
let themeCookieExpiry = 90; // days

const AddDarkTheme = () => {
  const cookies = new Cookies();
  const isThemeToggleEnabled = getConfig().INDIGO_ENABLE_DARK_TOGGLE;

  const getCookieExpiry = () => {
    const today = new Date();
    return new Date(today.getFullYear(), today.getMonth(), today.getDate() + themeCookieExpiry);
  };

  const getCookieOptions = () => {
    const serverURL = new URL(getConfig().LMS_BASE_URL);
    const options = { domain: serverURL.hostname, path: '/', expires: getCookieExpiry() };
    return options;
  };

  // Shared id so P1 (this on-load injector), P2 (the header ThemeToggleButton)
  // and P3 (the LmsHtmlFragment srcDoc script) all own AT MOST ONE dark style
  // per iframe. Keeping the id identical lets injection be idempotent (skip if
  // present) and removal complete (remove every node with this id).
  const iframeDarkStyleId = 'ost2-iframe-dark';
  const iframeDarkCss = `
          body{
            background-color: #0D0D0E;
            color: #F8F8F8;
          }
          h1,h2,h3,h4,h5,h6,p,li,span,div,td,th,dt,dd,label,blockquote,figcaption {color: #F8F8F8 !important;}
          a, a * {color: #AEC7F6 !important;}
          a:hover{color: #d3d3d3;}
          .forum-nav-refine-bar,.forum-nav-sort-control,.forum-nav-thread-list,.forum-nav,.forum-nav-load-more {background-color: #0D0D0E !important;}
          .forum-nav-refine-bar,.forum-nav-refine-bar *,.forum-nav-sort-control,.forum-nav-sort-control select,.forum-nav-load-more a {color: #F8F8F8 !important;}
          `;

  const addDarkThemeToIframes = () => {
    const iframes = document.getElementsByTagName('iframe');
    const iframesLength = iframes.length;
    if (iframesLength > 0) {
      Array.from({ length: iframesLength }).forEach((_, index) => {
        const iframeDoc = iframes[index].contentDocument;
        if (!iframeDoc || !iframeDoc.head) { return; }
        // Idempotent: at most one dark style per iframe head. The 15s
        // MutationObserver fires on every DOM mutation, so a non-idempotent
        // append would stack many duplicate styles in a single iframe.
        if (iframeDoc.getElementById(iframeDarkStyleId)) { return; }
        const style = iframeDoc.createElement('style');
        style.id = iframeDarkStyleId;
        style.textContent = iframeDarkCss;
        iframeDoc.head.appendChild(style);
      });
    }
  };

  const removeDarkThemeFromIframes = () => {
    const iframes = document.getElementsByTagName('iframe');
    const iframesLength = iframes.length;
    Array.from({ length: iframesLength }).forEach((_, index) => {
      const iframeDoc = iframes[index].contentDocument;
      if (!iframeDoc || !iframeDoc.head) { return; }
      // Remove ALL dark styles in this iframe head (not a single .find()), so
      // any leftover/duplicate style is cleared on toggle->light.
      iframeDoc.head.querySelectorAll(`style#${iframeDarkStyleId}`).forEach((node) => node.remove());
    });
  };

  useEffect(() => {
    const theme = cookies.get(themeCookie);

    // - When page loads, Footer loads before MFE content. Since there is no iframe on page,
    // it does not append any class. MutationObserver observes changes in DOM and hence appends dark
    // attributes when iframe is added. After 15 sec, this observer is destroyed to conserve resources. 
    // - It has been added outside dark-theme condition so that it can be removed on Component Unmount.
    // - Observer can be passed to `addDarkThemeToIframes` function and disconnected after observing Iframe.
    // This approach has a limitation: the observer first detects the iframe and then detects the docSrc. 
    // We need to wait for docSrc to fully load before appending the style tag.
    const observer = new MutationObserver(() => {
      // Decide from the ACTUAL visible state, not the (possibly stale) cookie:
      // if the user toggled to light during this 15s window, P2 already removed
      // the iframe styles - re-adding here would re-darken them. Only inject
      // while the body is still dark; otherwise clear any leftovers.
      if (document.body.classList.contains('indigo-dark-theme')) {
        addDarkThemeToIframes();
      } else {
        removeDarkThemeFromIframes();
      }
    });

    if (isThemeToggleEnabled && theme === 'dark') {
      document.body.classList.add('indigo-dark-theme');
      
      observer.observe(document.body, { childList: true, subtree: true });
      setTimeout(() => observer?.disconnect(), 15000); // clear after 15 sec to avoid resource usage

      cookies.set(themeCookie, theme, getCookieOptions());      //  on page load, update expiry
    }

    return () => observer?.disconnect();
  }, []);

  return (<div />);
};
