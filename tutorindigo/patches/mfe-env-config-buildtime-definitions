// Full-width strip above the page header. The brand's dark theme leaves alert-danger light (with light text), so
// dark mode gets the same warning/danger surfaces as the LMS's own dark page banners (indigo _extras.scss).
const ost2ActivationBannerCss = { __html: '.ost2-activation-banner .alert{margin:0;border-radius:0;border-width:0 0 1px;}.ost2-activation-banner .alert-message-content p:last-child{margin-bottom:0;}.ost2-activation-banner .pgn__alert-actions{flex-wrap:wrap;gap:.5rem;}.ost2-activation-banner .alert .pgn__alert-actions .btn{margin:0;}body.indigo-dark-theme .ost2-activation-banner .alert{color:#dddfe2;}body.indigo-dark-theme .ost2-activation-banner .alert-heading,body.indigo-dark-theme .ost2-activation-banner strong{color:#f8f8f8;}body.indigo-dark-theme .ost2-activation-banner .alert-warning{background-color:#352c14;border-color:#8a6d1f;}body.indigo-dark-theme .ost2-activation-banner .alert-danger{background-color:#3a1d20;border-color:#8a3a40;}' };

// The JWT cookie's email_verified claim is the account's is_active when the cookie was made (it is remade at
// least hourly), so active learners, nearly everyone, never call the notice API; a stale "false" costs one call.
const ost2JwtSaysActivated = () => {
  try {
    const token = new Cookies().get(getConfig().ACCESS_TOKEN_COOKIE_NAME);
    const payload = JSON.parse(atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));
    return payload.email_verified === true;
  } catch (e) {
    return false;
  }
};

const OST2AccountActivationBanner = () => {
  const intl = useIntl();
  const [notice, setNotice] = useState(null);
  const [container, setContainer] = useState(null);
  const [resendState, setResendState] = useState('default');

  useEffect(() => {
    if (!getAuthenticatedUser() || ost2JwtSaysActivated()) { return undefined; }
    let active = true;
    const load = () => getAuthenticatedHttpClient()
      .get(`${getConfig().LMS_BASE_URL}/api/account_activation_notice`)
      .then((response) => { if (active) { setNotice(response.data.notice); } })
      .catch(() => {});
    load();
    // Look again when the learner comes back to this tab, e.g. from the link in their email.
    const onVisibilityChange = () => { if (document.visibilityState === 'visible') { load(); } };
    document.addEventListener('visibilitychange', onVisibilityChange);
    return () => {
      active = false;
      document.removeEventListener('visibilitychange', onVisibilityChange);
    };
  }, []);

  // Rendered into a node at the top of <body>, above the MFE's header, so it is the first thing on every page.
  const shown = Boolean(notice);
  useEffect(() => {
    if (!shown) { return undefined; }
    const node = document.createElement('div');
    node.className = 'ost2-activation-banner';
    document.body.prepend(node);
    setContainer(node);
    return () => {
      node.remove();
      setContainer(null);
    };
  }, [shown]);

  if (!notice || !container) { return null; }

  const resend = () => {
    setResendState('pending');
    getAuthenticatedHttpClient()
      .post(`${getConfig().LMS_BASE_URL}/api/send_account_activation_email`)
      .then(() => setResendState('complete'))
      .catch((error) => setResendState(error.response?.status === 429 ? 'limited' : 'failed'));
  };
  const resendLabels = {
    default: intl.formatMessage(ost2ActivationMessages.resend),
    pending: intl.formatMessage(ost2ActivationMessages.resendPending),
    complete: intl.formatMessage(ost2ActivationMessages.resendComplete),
    limited: intl.formatMessage(ost2ActivationMessages.resend),
    failed: intl.formatMessage(ost2ActivationMessages.resend),
  };
  const emailFieldUrl = `${(getConfig().ACCOUNT_SETTINGS_URL || '').replace(/\/$/, '')}/#email`;
  const changeLink = (message) => (
    <Button key="change" as="a" href={emailFieldUrl} variant="outline-primary">
      {intl.formatMessage(message)}
    </Button>
  );
  const deletion = notice.delete_after ? (
    <FormattedMessage
      {...ost2ActivationMessages.deletion}
      values={ {
        date: <strong>{intl.formatDate(notice.delete_after, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</strong>,
      } }
    />
  ) : '';

  let title;
  let body;
  let actions;
  if (notice.variant === 'email_change_pending') {
    title = ost2ActivationMessages.pendingTitle;
    body = <FormattedMessage {...ost2ActivationMessages.pendingBody} values={ { pendingEmail: <strong>{notice.pending_email}</strong>, deletion } } />;
    actions = [changeLink(ost2ActivationMessages.changeAgain)];
  } else if (notice.variant === 'bounced') {
    title = ost2ActivationMessages.bouncedTitle;
    body = <FormattedMessage {...ost2ActivationMessages.bouncedBody} values={ { email: <strong>{notice.email}</strong>, deletion } } />;
    actions = [changeLink(ost2ActivationMessages.changeEmail)];
  } else {
    title = ost2ActivationMessages.unactivatedTitle;
    body = <FormattedMessage {...ost2ActivationMessages.unactivatedBody} values={ { email: <strong>{notice.email}</strong> } } />;
    actions = [
      <StatefulButton
        key="resend"
        state={resendState}
        labels={resendLabels}
        disabledStates={['pending', 'complete']}
        variant="primary"
        onClick={resend}
      />,
      changeLink(ost2ActivationMessages.changeWrongAddress),
    ];
  }

  return createPortal(
    <>
      <style dangerouslySetInnerHTML={ost2ActivationBannerCss} />
      <Alert
        variant={notice.bounced ? 'danger' : 'warning'}
        icon={notice.bounced ? ErrorIcon : WarningFilled}
        actions={actions}
        stacked
      >
        <Alert.Heading>{intl.formatMessage(title)}</Alert.Heading>
        <p>{body}</p>
        {resendState === 'limited' && <p>{intl.formatMessage(ost2ActivationMessages.resendLimited)}</p>}
        {resendState === 'failed' && <p>{intl.formatMessage(ost2ActivationMessages.resendFailed)}</p>}
      </Alert>
    </>,
    container,
  );
};
